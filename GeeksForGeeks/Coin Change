class Solution:
    def count(self, coins: list[int], sum: int) -> int:
        # def no_of_ways(n, sum):
        #     if sum == 0:
        #         return 1
        #     if n == 0:
        #         return 0

        #     n_no_of_ways = no_of_ways(n - 1, sum)

        #     if coins[n - 1] <= sum:
        #         n_no_of_ways += no_of_ways(n, sum - coins[n - 1])

        #     return n_no_of_ways

        # return no_of_ways(len(coins), sum)
        
        dp = [0]*(sum+1)
        dp[0] = 1
        for coin in coins:
            for i in range(coin,sum+1):
                dp[i] += dp[i-coin]
                
        return dp[sum]
